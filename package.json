{
  "name": "smartlock-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run cf:build",
    "next:build": "npm run cf:bindings && npm run articles:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "cf:bindings": "node scripts/configure-cloudflare-bindings.mjs",
    "articles:generate": "node scripts/generate-article-content.mjs",
    "cf:build": "npm run cf:bindings && npm run articles:generate && opennextjs-cloudflare build",
    "preview": "npm run cf:build && wrangler dev .open-next/worker.js --assets .open-next/assets",
    "deploy": "npm run cf:build && wrangler deploy --x-autoconfig=false",
    "upload": "npm run cf:build && wrangler deploy --x-autoconfig=false --dry-run --outdir bundled",
    "cf:d1:import": "wrangler d1 execute slockhub --remote --file database/d1-import-ordered.sql",
    "cf:d1:counts": "wrangler d1 execute slockhub --remote --command \"SELECT 'brands' AS table_name, COUNT(*) AS count FROM brands UNION ALL SELECT 'products', COUNT(*) FROM products UNION ALL SELECT 'product_series', COUNT(*) FROM product_series UNION ALL SELECT 'top_n_pages', COUNT(*) FROM top_n_pages\"",
    "test:db-facade": "tsx tests/db-facade.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "hono": "^4.10.6",
    "jose": "^5.2.0",
    "lucide-react": "^0.344.0",
    "marked": "^17.0.1",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.8.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "gray-matter": "^4.0.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "wrangler": "4.90.0"
  }
}
