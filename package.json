{
  "name": "smartlock-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run cf:bindings && next build",
    "start": "next start",
    "lint": "next lint",
    "cf:bindings": "node scripts/configure-cloudflare-bindings.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "npm run cf:bindings && npm run cf:build && wrangler dev",
    "deploy": "npm run cf:bindings && wrangler deploy",
    "upload": "npm run cf:bindings && wrangler deploy --dry-run --outdir bundled",
    "test:db-facade": "tsx tests/db-facade.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "hono": "^4.10.6",
    "jose": "^5.2.0",
    "lucide-react": "^0.344.0",
    "marked": "^17.0.1",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
