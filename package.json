    "@types/react-dom": "^18.2.0",
    "@opennextjs/cloudflare": "1.3.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "gray-matter": "^4.0.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "wrangler": "4.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
