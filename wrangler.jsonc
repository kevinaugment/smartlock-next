{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartlock-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slockhub",
      "database_id": "1d2ea8dd-d7eb-440b-8b91-a9070bd7bb34"
    }
  ],
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "NEXT_RUNTIME": "cloudflare"
  },
  "build": {
    "command": "npm run cf:build"
  }
}
